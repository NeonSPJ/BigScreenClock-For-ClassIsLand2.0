<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cp="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.ColorPicker"
             x:Class="EveningSelfStudyClock.Settings.SettingsPage">
    <Grid ColumnDefinitions="*,280" Margin="12">

        <!-- ===== 左栏：设置（可滚动） ===== -->
        <ScrollViewer Grid.Column="0" Padding="0,0,12,0">
            <StackPanel Spacing="14" Margin="4,8,0,8">

                <!-- 功能开关 -->
                <Border Background="#1e1e2e" CornerRadius="8" Padding="14,12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="⚙ 显示开关" FontSize="17" FontWeight="Bold" Foreground="#ffffff"/>
                        <CheckBox IsChecked="{Binding ShowDecibelMeter}" FontSize="14" Foreground="#ffffff">🎤 教室音量</CheckBox>
                        <CheckBox IsChecked="{Binding ShowCourseInfo}" FontSize="14" Foreground="#ffffff">📋 课程信息</CheckBox>
                        <CheckBox IsChecked="{Binding ShowNoisyCounter}" FontSize="14" Foreground="#ffffff">📊 吵闹计数</CheckBox>
                    </StackPanel>
                </Border>

                <!-- 目标课程 -->
                <Border Background="#1e1e2e" CornerRadius="8" Padding="14,12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="📋 触发课程" FontSize="17" FontWeight="Bold" Foreground="#ffffff"/>
                        <TextBlock Text="选择要触发的课程，可添加多个。" FontSize="12" Foreground="#88ffffff" TextWrapping="Wrap"/>
                        <ItemsControl ItemsSource="{Binding SelectedCourses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2" ColumnSpacing="6">
                                        <ComboBox ItemsSource="{Binding AllCourses}"
                                                  SelectedItem="{Binding SelectedName}"
                                                  FontSize="13" Padding="6,3"/>
                                        <Button Grid.Column="1" Content="✕" FontSize="13"
                                                Foreground="#ff6666" Background="Transparent"
                                                BorderThickness="0" Cursor="Hand" Padding="6,3"
                                                Command="{Binding RemoveCommand}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="＋ 添加课程" FontSize="13"
                                Foreground="#88ccff" Background="#22ffffff"
                                CornerRadius="6" Padding="8,5"
                                Cursor="Hand" Click="AddCourse_Click"/>
                    </StackPanel>
                </Border>

                <!-- 音量检测 -->
                <Border Background="#1e1e2e" CornerRadius="8" Padding="14,12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="🔊 音量检测" FontSize="17" FontWeight="Bold" Foreground="#ffffff"/>
                        <TextBlock Text="使用系统默认麦克风采集" FontSize="11" Foreground="#88ffffff"/>
                        <TextBlock Text="等级阈值 (RMS)  —— 拖动滑块或直接填数字（范围 0.001~1.000）" FontSize="12" Foreground="#aaffffff" Margin="0,4,0,0"/>
                        <Grid ColumnDefinitions="Auto,*,Auto" RowSpacing="6" ColumnSpacing="8"
                              RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="安静" VerticalAlignment="Center" Foreground="#aaffffff" FontSize="13"/>
                            <Slider Grid.Row="0" Grid.Column="1" Minimum="-3" Maximum="0" TickFrequency="0.1"
                                    Value="{Binding DecibelQuietThresholdIndex}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding DecibelQuietThresholdText}" FontSize="12" Padding="4" Width="70"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="良好" VerticalAlignment="Center" Foreground="#aaffffff" FontSize="13"/>
                            <Slider Grid.Row="1" Grid.Column="1" Minimum="-3" Maximum="0" TickFrequency="0.1"
                                    Value="{Binding DecibelGoodThresholdIndex}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding DecibelGoodThresholdText}" FontSize="12" Padding="4" Width="70"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="一般" VerticalAlignment="Center" Foreground="#aaffffff" FontSize="13"/>
                            <Slider Grid.Row="2" Grid.Column="1" Minimum="-3" Maximum="0" TickFrequency="0.1"
                                    Value="{Binding DecibelNormalThresholdIndex}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding DecibelNormalThresholdText}" FontSize="12" Padding="4" Width="70"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="吵闹" VerticalAlignment="Center" Foreground="#aaffffff" FontSize="13"/>
                            <Slider Grid.Row="3" Grid.Column="1" Minimum="-3" Maximum="0" TickFrequency="0.1"
                                    Value="{Binding DecibelNoisyThresholdIndex}" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding DecibelNoisyThresholdText}" FontSize="12" Padding="4" Width="70"/>
                            <TextBlock Grid.Row="4" Grid.ColumnSpan="3" Text="超过吵闹 = 「嘈杂」；建议从小到大填写" FontSize="11" Foreground="#66ffffff"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 记录参数 -->
                <Border Background="#1e1e2e" CornerRadius="8" Padding="14,12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="🧮 记录参数" FontSize="17" FontWeight="Bold" Foreground="#ffffff"/>
                        <Grid ColumnDefinitions="Auto,*,Auto" RowSpacing="6" ColumnSpacing="8"
                              RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="起算底线" VerticalAlignment="Center" Foreground="#aaffffff" FontSize="13"/>
                            <Slider Grid.Row="0" Grid.Column="1" Value="{Binding NoisySustainSeconds}"
                                    Minimum="0.5" Maximum="5" TickFrequency="0.1"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding NoisySustainSecondsText}" FontSize="12"
                                       Foreground="#ffffff" Width="56" TextAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="回落窗口" VerticalAlignment="Center" Foreground="#aaffffff" FontSize="13"/>
                            <Slider Grid.Row="1" Grid.Column="1" Value="{Binding FallWindowSeconds}"
                                    Minimum="0" Maximum="15" TickFrequency="0.5"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding FallWindowSecondsText}" FontSize="12"
                                       Foreground="#ffffff" Width="56" TextAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="保护时长" VerticalAlignment="Center" Foreground="#aaffffff" FontSize="13"/>
                            <Slider Grid.Row="2" Grid.Column="1" Value="{Binding SkipFirstMinutes}"
                                    Minimum="0" Maximum="10" TickFrequency="1"
                                    IsEnabled="{Binding SkipFirst3Min}"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding SkipFirstMinutesText}" FontSize="12"
                                       Foreground="#ffffff" Width="56" TextAlignment="Center" VerticalAlignment="Center"/>
                            <CheckBox Grid.Row="3" Grid.ColumnSpan="3" IsChecked="{Binding SkipFirst3Min}"
                                      FontSize="13" Foreground="#ffffff">🛡 上课初期保护（上课开始后前 N 分钟不计数）</CheckBox>
                            <CheckBox Grid.Row="4" Grid.ColumnSpan="3" IsChecked="{Binding EnableNoiseDebugLog}"
                                      FontSize="13" Foreground="#ffffff">🛠 调试日志（输出 NoiseDebugLog.csv，用于收集真实数据校准阈值）</CheckBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 外观 -->
                <Border Background="#1e1e2e" CornerRadius="8" Padding="14,12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="🎨 外观" FontSize="17" FontWeight="Bold" Foreground="#ffffff"/>
                        <TextBlock Text="颜色用 HSV 取色器调整：点击色块弹出色相条 + 色板，也可直接填 hex" FontSize="11" Foreground="#88ffffff" TextWrapping="Wrap"/>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Text="时钟字号" VerticalAlignment="Center" Foreground="#aaffffff" FontSize="13"/>
                            <Slider Grid.Column="1" Value="{Binding ClockFontSize}" Minimum="60" Maximum="400"
                                    TickFrequency="20" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding ClockFontSizeText}" FontSize="12"
                                       Foreground="#ffffff" Width="40" TextAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <!-- 颜色选择：色块在每行最右，点击弹出 HSV 面板 -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <TextBlock Grid.Column="0" Text="背景颜色" VerticalAlignment="Center" Foreground="#aaffffff" FontSize="13"/>
                            <TextBlock Grid.Column="1" Text="{Binding BackgroundColorHex}" FontSize="12" Foreground="#99ffffff"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <cp:ColorPicker Grid.Column="2" Color="{Binding BackgroundColorValue}"
                                            IsAccentColorsVisible="False" Width="90" Height="28"
                                            HorizontalAlignment="Right">
                                <cp:ColorPicker.Content>
                                    <Border Background="{Binding BackgroundColorBrush}" CornerRadius="3"
                                            BorderBrush="#44ffffff" BorderThickness="1"/>
                                </cp:ColorPicker.Content>
                            </cp:ColorPicker>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <TextBlock Grid.Column="0" Text="字体颜色" VerticalAlignment="Center" Foreground="#aaffffff" FontSize="13"/>
                            <TextBlock Grid.Column="1" Text="{Binding FontColorHex}" FontSize="12" Foreground="#99ffffff"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <cp:ColorPicker Grid.Column="2" Color="{Binding FontColorValue}"
                                            IsAccentColorsVisible="False" Width="90" Height="28"
                                            HorizontalAlignment="Right">
                                <cp:ColorPicker.Content>
                                    <Border Background="{Binding FontColorBrush}" CornerRadius="3"
                                            BorderBrush="#44ffffff" BorderThickness="1"/>
                                </cp:ColorPicker.Content>
                            </cp:ColorPicker>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <TextBlock Grid.Column="0" Text="强调色" VerticalAlignment="Center" Foreground="#aaffffff" FontSize="13"/>
                            <TextBlock Grid.Column="1" Text="{Binding AccentColorHex}" FontSize="12" Foreground="#99ffffff"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <cp:ColorPicker Grid.Column="2" Color="{Binding AccentColorValue}"
                                            IsAccentColorsVisible="False" Width="90" Height="28"
                                            HorizontalAlignment="Right">
                                <cp:ColorPicker.Content>
                                    <Border Background="{Binding AccentColorBrush}" CornerRadius="3"
                                            BorderBrush="#44ffffff" BorderThickness="1"/>
                                </cp:ColorPicker.Content>
                            </cp:ColorPicker>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <TextBlock Grid.Column="0" Text="进度条颜色" VerticalAlignment="Center" Foreground="#aaffffff" FontSize="13"/>
                            <TextBlock Grid.Column="1" Text="{Binding ProgressColorHex}" FontSize="12" Foreground="#99ffffff"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <cp:ColorPicker Grid.Column="2" Color="{Binding ProgressColorValue}"
                                            IsAccentColorsVisible="False" Width="90" Height="28"
                                            HorizontalAlignment="Right">
                                <cp:ColorPicker.Content>
                                    <Border Background="{Binding ProgressColorBrush}" CornerRadius="3"
                                            BorderBrush="#44ffffff" BorderThickness="1"/>
                                </cp:ColorPicker.Content>
                            </cp:ColorPicker>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 规则说明 -->
                <Border Background="#1e1e2e" CornerRadius="8" Padding="14,12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="📝 记录规则" FontSize="17" FontWeight="Bold" Foreground="#ffffff"/>
                        <TextBlock Text="• 一段噪音累计满「起算底线」秒才记一次（默认 1 秒），咳嗽、喷嚏等瞬时噪音不计数" FontSize="12" Foreground="#aaffffff" TextWrapping="Wrap"/>
                        <TextBlock Text="• 一段内音量短暂回落到安静/良好（不超过「回落窗口」，默认 5 秒）又重新吵起，仍并成一次" FontSize="12" Foreground="#aaffffff" TextWrapping="Wrap"/>
                        <TextBlock Text="• 一段噪音按一般/吵闹的时长占比归属：吵闹占一半及以上记「吵闹」，否则记「一般」" FontSize="12" Foreground="#aaffffff" TextWrapping="Wrap"/>
                        <TextBlock Text="• 开启「上课初期保护」后，上课开始后前 N 分钟不计数" FontSize="12" Foreground="#aaffffff" TextWrapping="Wrap"/>
                        <TextBlock Text="⚠ 免责声明：分贝记录仅供参考，可能受教室风扇、空调、开关门、桌椅移动、脚步声等环境杂音影响，不代表真实纪律状况。" FontSize="12" Foreground="#ffaa44" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ===== 右栏：实时预览（置顶不滚动）+ 进入全屏时钟 ===== -->
        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Top" Margin="4,8,0,0">
            <Border Background="#000000" CornerRadius="12" Padding="12,10">
            <StackPanel Spacing="4" HorizontalAlignment="Center" Width="240">
                <TextBlock Text="预览" FontSize="11" Foreground="#55ffffff"
                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding PreviewTime}"
                           FontSize="{Binding PreviewFontSize}"
                           FontWeight="Bold" Foreground="#ffffff"
                           FontFamily="Consolas,monospace"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding PreviewCourseText}" IsVisible="{Binding ShowCourseInfo}"
                           FontSize="11" FontWeight="Bold" Foreground="#88ccff"
                           HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                <Border Background="#1a1a2e" CornerRadius="6" Padding="6,4"
                        IsVisible="{Binding ShowDecibelMeter}"
                        HorizontalAlignment="Center">
                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                        <TextBlock Text="📢 教室音量" FontSize="9" Foreground="#aaffffff" HorizontalAlignment="Center"/>
                        <Border Background="#33ffffff" CornerRadius="2" Height="3" Width="160"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="2">
                            <TextBlock Text="🙂" FontSize="11"/>
                            <TextBlock Text="安静" FontSize="10" Foreground="#ffffff"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <TextBlock Text="晚自习  吵闹 2 次" IsVisible="{Binding ShowNoisyCounter}"
                           FontSize="10" Foreground="#ffff44" HorizontalAlignment="Center"
                           FontWeight="Bold"/>
            </StackPanel>
            </Border>
            <Button Content="▶ 进入全屏时钟"
                    FontSize="15" FontWeight="Bold"
                    Foreground="#ffffff" Background="#4CAF50"
                    CornerRadius="8" Padding="10,8"
                    Cursor="Hand" Click="TestButton_Click"
                    HorizontalAlignment="Stretch"/>
        </StackPanel>
    </Grid>
</UserControl>
