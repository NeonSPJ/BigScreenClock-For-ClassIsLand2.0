<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EveningSelfStudyClock.Views.FullScreenClockWindow"
        Title="{Binding WindowTitle}"
        WindowState="FullScreen"
        SystemDecorations="None"
        ShowInTaskbar="False"
        CanResize="False"
        Background="{Binding BackgroundColor}"
        FontFamily="Microsoft YaHei,SimHei,sans-serif">

    <Grid RowDefinitions="Auto,*,Auto,Auto"
          Margin="40,30,40,18">

        <!-- 日期（右上角，连点 7 次弹出关于窗口） -->
        <TextBlock Grid.Row="0" Text="{Binding CurrentDate}"
                   FontSize="22" Foreground="#66ffffff"
                   HorizontalAlignment="Right" PointerPressed="DateText_PointerPressed"/>

        <!-- 主体 -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">
            <!-- 时间 -->
            <TextBlock Text="{Binding CurrentTime}"
                       FontSize="{Binding ClockFontSize}"
                       FontWeight="Bold"
                       Foreground="{Binding FontColor}"
                       FontFamily="Consolas,monospace"
                       HorizontalAlignment="Center"/>

            <!-- 课程时间信息 -->
            <TextBlock Text="{Binding CourseInfoText}"
                       FontSize="28" FontWeight="Bold"
                       Foreground="#88ccff"
                       HorizontalAlignment="Center"
                       IsVisible="{Binding ShowCourseInfo}"/>

            <!-- 分贝 -->
            <Border Background="#1a1a2e" CornerRadius="16" Padding="32,20" Width="640"
                    HorizontalAlignment="Center"
                    IsVisible="{Binding ShowDecibelMeter}">
                <StackPanel Spacing="12">
                    <TextBlock Text="📢 教室音量" FontSize="18" Foreground="#aaffffff" HorizontalAlignment="Center"/>
                    <ProgressBar Value="{Binding NoiseLevelProgress}"
                                 Minimum="0" Maximum="100" Height="10"
                                 Background="#33ffffff"
                                 Foreground="{Binding AccentColor}"
                                 CornerRadius="5"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                        <TextBlock Text="{Binding NoiseLevelEmoji}" FontSize="36"/>
                        <TextBlock Text="{Binding NoiseLevelText}" FontSize="32" FontWeight="Bold"
                                   Foreground="#ffffff" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 底部 -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,6,0,0">
            <!-- 吵闹计数（分段着色：一般=黄，吵闹=红）+ 实时「正在记录」提示。
                 鼠标悬停上方时在计数区上方弹出记录规则 -->
            <Border Grid.Column="0" VerticalAlignment="Center"
                    x:Name="CounterAreaBorder"
                    PointerEntered="CounterArea_PointerEntered"
                    PointerExited="CounterArea_PointerExited">
                <StackPanel Orientation="Horizontal">
                    <ItemsControl ItemsSource="{Binding NoisyDisplaySegments}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}"
                                           FontSize="24" FontWeight="Bold"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding RecordingText}"
                               Foreground="{Binding RecordingForeground}"
                               IsVisible="{Binding IsRecordingVisible}"
                               FontSize="24" FontWeight="Bold" Margin="16,0,0,0"/>
                </StackPanel>
            </Border>
            <Button Grid.Column="1" Content="✕ 退出全屏时钟"
                    FontSize="15" Foreground="#ffffff44"
                    Background="#22ffffff" BorderThickness="0"
                    CornerRadius="6" Padding="12,6"
                    Cursor="Hand" Opacity="0.5"
                    Click="ExitButton_Click">
                <Button.Styles>
                    <Style Selector="Button:pointerover">
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="Background" Value="#44ffffff"/>
                    </Style>
                </Button.Styles>
            </Button>
        </Grid>

        <!-- 课程/时段进度条（上课=本课进度，课间=休息进度）+ 免责声明。
             深色=已进行，浅色=未进行；放学/无时段时进度条隐藏 -->
        <StackPanel Grid.Row="3" Margin="0,10,0,0" Spacing="6">
            <ProgressBar Value="{Binding CourseProgress}" Minimum="0" Maximum="100"
                         Height="6" CornerRadius="3"
                         Foreground="{Binding ProgressFillBrush}"
                         Background="{Binding ProgressTrackBrush}"
                         IsVisible="{Binding ShowCourseProgress}"/>
            <TextBlock Text="{Binding DisclaimerText}"
                       FontSize="10" Foreground="#40ffffff"
                       HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- 记录规则：鼠标悬停计数区域时在其上方弹出。独立浮层（Popup 不占布局），
             避免规则出现/消失导致计数区上下位移、鼠标反复脱离引发的排版抖动 -->
        <Popup x:Name="RulesPopup"
               Placement="Top"
               VerticalOffset="-8"
               IsOpen="{Binding ShowCountRules}"
               IsLightDismissEnabled="False">
            <Border Background="#14141f" CornerRadius="10" Padding="16,10"
                    BorderBrush="#44ffffff" BorderThickness="1" MaxWidth="720">
                <TextBlock Text="{Binding CountRulesText}"
                           FontSize="13" Foreground="#ddffffff"
                           TextAlignment="Center" TextWrapping="Wrap"/>
            </Border>
        </Popup>
    </Grid>
</Window>
