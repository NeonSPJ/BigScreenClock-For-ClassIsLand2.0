<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EveningSelfStudyClock.Views.FullScreenClockWindow"
        Title="{Binding WindowTitle}"
        WindowState="FullScreen"
        SystemDecorations="None"
        ShowInTaskbar="False"
        CanResize="False"
        Background="{Binding BackgroundColor}"
        FontFamily="Microsoft YaHei,SimHei,sans-serif">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- 底部全宽课程进度带 -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 主内容（原有布局，Margins 保持不变） -->
        <Grid Grid.Row="0" RowDefinitions="Auto,*,Auto,Auto"
              Margin="40,30,40,18">

            <!-- 顶部行：天气 + 倒计时 + 预警详情弹幕 + 日期。
                 按「天气+倒计时+弹幕实际宽度是否超过屏幕 2/3」在 单行/双行 间切换（VM 的 CountdownWrapped）：
                 - 单行：天气、倒计时、弹幕同排，弹幕占「倒计时末尾 → 日期前」的剩余宽度，随倒计时长度自适应；
                 - 双行：倒计时换行到天气下方，弹幕拉长到整行。 -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto"
                  IsVisible="{Binding !CountdownWrapped}">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center" IsVisible="{Binding ShowWeatherRow}">
                    <TextBlock Text="{Binding WeatherIcon}" FontSize="20" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding WeatherText}" FontSize="19" FontWeight="Bold"
                               Foreground="#FFFFFF" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                    <TextBlock Text="{Binding WeatherSubtitle}" FontSize="11" Foreground="#AAFFFFFF"
                               VerticalAlignment="Center" Margin="8,0,0,0"
                               IsVisible="{Binding HasWeatherSubtitle}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="28,0,0,0"
                            VerticalAlignment="Center" IsVisible="{Binding ShowCountdownRow}">
                    <TextBlock Text="⏳" FontSize="20" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CountdownText}" FontSize="19" FontWeight="Bold"
                               Foreground="#FFFFDD" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                    <TextBlock Text="{Binding CountdownSubtitle}" FontSize="11" Foreground="#AAFFFFFF"
                               VerticalAlignment="Center" Margin="8,0,0,0"
                               IsVisible="{Binding HasCountdownSubtitle}"/>
                </StackPanel>
                <ScrollViewer x:Name="AlertDetailScrollInline" Grid.Column="2"
                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                              Margin="28,0,0,0" VerticalAlignment="Center"
                              IsVisible="{Binding HasExpandedAlert}"
                              SizeChanged="DetailScroll_SizeChanged">
                    <TextBlock Text="{Binding ExpandedAlertDetail}" FontSize="16" Foreground="#BBFFFFFF"
                               TextWrapping="NoWrap" VerticalAlignment="Center"/>
                </ScrollViewer>
                <StackPanel Grid.Column="3" Margin="28,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentDate}" FontSize="22" Foreground="#66ffffff"
                               HorizontalAlignment="Right" PointerPressed="DateText_PointerPressed"/>
                    <TextBlock Text="{Binding DateSubtitle}" FontSize="11" Foreground="#AAFFFFFF"
                               HorizontalAlignment="Right" IsVisible="{Binding HasDateSubtitle}"/>
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="0" Spacing="4" IsVisible="{Binding CountdownWrapped}">
                <!-- 第一行：天气 + 弹幕 + 日期（倒计时换行腾出的位置给弹幕） -->
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center" IsVisible="{Binding ShowWeatherRow}">
                        <TextBlock Text="{Binding WeatherIcon}" FontSize="20" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding WeatherText}" FontSize="19" FontWeight="Bold"
                                   Foreground="#FFFFFF" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                        <TextBlock Text="{Binding WeatherSubtitle}" FontSize="11" Foreground="#AAFFFFFF"
                                   VerticalAlignment="Center" Margin="8,0,0,0"
                                   IsVisible="{Binding HasWeatherSubtitle}"/>
                    </StackPanel>
                    <ScrollViewer x:Name="AlertDetailScrollWrapped" Grid.Column="1"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  Margin="28,0,0,0" VerticalAlignment="Center"
                                  IsVisible="{Binding HasExpandedAlert}" SizeChanged="DetailScroll_SizeChanged">
                        <TextBlock Text="{Binding ExpandedAlertDetail}" FontSize="16" Foreground="#BBFFFFFF"
                                   TextWrapping="NoWrap" VerticalAlignment="Center"/>
                    </ScrollViewer>
                    <StackPanel Grid.Column="2" Margin="28,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentDate}" FontSize="22" Foreground="#66ffffff"
                                   HorizontalAlignment="Right" PointerPressed="DateText_PointerPressed"/>
                        <TextBlock Text="{Binding DateSubtitle}" FontSize="11" Foreground="#AAFFFFFF"
                                   HorizontalAlignment="Right" IsVisible="{Binding HasDateSubtitle}"/>
                    </StackPanel>
                </Grid>
                <!-- 第二行：倒计时 -->
                <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding ShowCountdownRow}">
                    <TextBlock Text="⏳" FontSize="20" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CountdownText}" FontSize="19" FontWeight="Bold"
                               Foreground="#FFFFDD" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                    <TextBlock Text="{Binding CountdownSubtitle}" FontSize="11" Foreground="#AAFFFFFF"
                               VerticalAlignment="Center" Margin="8,0,0,0"
                               IsVisible="{Binding HasCountdownSubtitle}"/>
                </StackPanel>
            </StackPanel>

            <!-- 主体 -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">
                <!-- 时间 -->
                <TextBlock x:Name="ClockText" Text="{Binding CurrentTime}"
                           FontSize="{Binding ClockFontSize}"
                           FontWeight="Bold"
                           Foreground="{Binding FontColor}"
                           FontFamily="Consolas,monospace"
                           HorizontalAlignment="Center"/>

                <!-- 课程时间信息 -->
                <TextBlock Text="{Binding CourseInfoText}"
                           FontSize="28" FontWeight="Bold"
                           Foreground="{Binding CourseInfoColor}"
                           HorizontalAlignment="Center"
                           IsVisible="{Binding ShowCourseInfo}"/>

                <!-- 教室音量：无背景「横向轨道 + 分段刻度」仪表盘式条（宽度跟随时间字体） -->
                <StackPanel Spacing="8" Width="{Binding #ClockText.Bounds.Width, FallbackValue=640}"
                            HorizontalAlignment="Center"
                            IsVisible="{Binding ShowDecibelMeter}">
                    <!-- 标题行：左「📢 教室音量」，右当前档位 emoji + 文字（档位色） -->
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="📢 教室音量" FontSize="20" FontWeight="Bold"
                                   Foreground="{Binding NoiseTitleColor}"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding NoiseLevelEmoji}" FontSize="20" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding NoiseLevelText}" FontSize="18" FontWeight="Bold"
                                       Foreground="{Binding NoiseLevelFillBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <!-- 轨道 + 分段刻度块（竖向实心矩形，略高于轨道、从轨道中突出） -->
                    <Grid ColumnDefinitions="1*,3,1*,3,1*,3,1*,3,1*" Height="16">
                        <ProgressBar Grid.ColumnSpan="9" Minimum="0" Maximum="100" Value="{Binding NoiseLevelProgress}"
                                     VerticalAlignment="Center" Height="5"
                                     Foreground="{Binding NoiseLevelFillBrush}"
                                     Background="{Binding NoiseLevelTrackBrush}">
                            <ProgressBar.Template>
                                <ControlTemplate TargetType="ProgressBar">
                                    <Grid>
                                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}"/>
                                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"/>
                                    </Grid>
                                </ControlTemplate>
                            </ProgressBar.Template>
                        </ProgressBar>
                        <Rectangle Grid.Column="1" Width="3" Height="13" Fill="#66ffffff" VerticalAlignment="Center" RadiusX="1.5"/>
                        <Rectangle Grid.Column="3" Width="3" Height="13" Fill="#66ffffff" VerticalAlignment="Center" RadiusX="1.5"/>
                        <Rectangle Grid.Column="5" Width="3" Height="13" Fill="#66ffffff" VerticalAlignment="Center" RadiusX="1.5"/>
                        <Rectangle Grid.Column="7" Width="3" Height="13" Fill="#66ffffff" VerticalAlignment="Center" RadiusX="1.5"/>
                    </Grid>
                    <!-- 五档文字：当前档位高亮+放大+档位色，其余淡化 -->
                    <ItemsControl ItemsSource="{Binding NoiseLevelSlots}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="5"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Opacity="{Binding TextOpacity}" FontSize="{Binding TextFontSize}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>

            <!-- 底部 -->
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                <!-- 吵闹计数（分段着色：一般=黄，吵闹=红）+ 实时「正在记录」提示。
                     鼠标悬停上方时在计数区上方弹出记录规则 -->
                <Border Grid.Column="0" VerticalAlignment="Center"
                        x:Name="CounterAreaBorder"
                        PointerEntered="CounterArea_PointerEntered"
                        PointerExited="CounterArea_PointerExited">
                    <StackPanel Orientation="Horizontal">
                        <ItemsControl ItemsSource="{Binding NoisyDisplaySegments}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}"
                                               FontSize="24" FontWeight="Bold"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding RecordingText}"
                                   Foreground="{Binding RecordingForeground}"
                                   IsVisible="{Binding IsRecordingVisible}"
                                   FontSize="24" FontWeight="Bold" Margin="16,0,0,0"/>
                    </StackPanel>
                </Border>
                <Button Grid.Column="1" Content="✕ 退出全屏时钟"
                        FontSize="15" Foreground="#ffffff44"
                        Background="#22ffffff" BorderThickness="0"
                        CornerRadius="6" Padding="12,6"
                        Cursor="Hand" Opacity="0.5"
                        Click="ExitButton_Click">
                    <Button.Styles>
                        <Style Selector="Button:pointerover">
                            <Setter Property="Opacity" Value="1"/>
                            <Setter Property="Background" Value="#44ffffff"/>
                        </Style>
                    </Button.Styles>
                </Button>
            </Grid>

            <!-- 免责声明（进度带已移至窗口最底部独立层） -->
            <StackPanel Grid.Row="3" Margin="0,10,0,0">
                <TextBlock Text="{Binding DisclaimerText}"
                           FontSize="10" Foreground="#40ffffff"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- 左上角提醒面板（无边框无背景纯文字：降雨提醒、文本、预警。天气/倒计时/预警详情弹幕在顶部行显示） -->
            <Border Grid.Row="1" Grid.RowSpan="3" HorizontalAlignment="Left" VerticalAlignment="Top"
                    MaxWidth="{Binding ReminderPanelMaxWidth}" MaxHeight="400"
                    IsHitTestVisible="True"
                    IsVisible="{Binding ShowReminderPanel}">
                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="8">
                        <!-- 降雨提醒：☔ + 主标题 + 小字号副标题（跟随天气开关） -->
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowRainReminder}">
                            <TextBlock Text="☔" FontSize="20" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding RainReminderTitle}" FontSize="19" FontWeight="Bold"
                                       Foreground="#FFFFFF" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding RainSubtitle}" FontSize="12" Foreground="#AAFFFFFF" VerticalAlignment="Center"
                                       IsVisible="{Binding HasRainSubtitle}"/>
                        </StackPanel>
                        <!-- 文本（跟随 CI 主界面文本组件） -->
                        <TextBlock Text="{Binding ReminderText}" FontSize="16" Foreground="#DDFFFFFF"
                                   TextWrapping="Wrap" IsVisible="{Binding ShowTextRow}"/>
                        <!-- 预警（排最下，区级统一发布按等级着色；点击标题右侧「>」在标题同一行右侧横向展开详情全文） -->
                        <StackPanel Spacing="3" IsVisible="{Binding ShowAlertsRow}">
                            <ItemsControl ItemsSource="{Binding AlertItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- 悬停该条预警即在顶部弹幕带显示其详情；移开即消失 -->
                                        <TextBlock Text="{Binding DisplayText}" Foreground="{Binding Foreground}"
                                                   FontSize="15" FontWeight="Bold" TextWrapping="Wrap" Cursor="Hand"
                                                   PointerEntered="AlertPointerEntered" PointerExited="AlertPointerExited"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 记录规则：鼠标悬停计数区域时在其上方弹出。独立浮层（Popup 不占布局），
                 避免规则出现/消失导致计数区上下位移、鼠标反复脱离引发的排版抖动 -->
            <Popup x:Name="RulesPopup"
                   Placement="Top"
                   VerticalOffset="-8"
                   IsOpen="{Binding ShowCountRules}"
                   IsLightDismissEnabled="False">
                <Border Background="#14141f" CornerRadius="10" Padding="16,10"
                        BorderBrush="#44ffffff" BorderThickness="1" MaxWidth="720">
                    <TextBlock Text="{Binding CountRulesText}"
                               FontSize="13" Foreground="#ddffffff"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                </Border>
            </Popup>
        </Grid>

        <!-- 底部全宽「底边进度带」：固定贴窗口最底部、横向铺满全屏，亮色已完成 + 深蓝低饱和剩余 -->
        <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding CourseProgress}"
                     Height="6" IsVisible="{Binding ShowCourseProgress}"
                     Foreground="{Binding ProgressFillBrush}" Background="{Binding ProgressTrackBrush}">
            <ProgressBar.Template>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}"/>
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"/>
                    </Grid>
                </ControlTemplate>
            </ProgressBar.Template>
        </ProgressBar>
    </Grid>
</Window>
