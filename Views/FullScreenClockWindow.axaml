<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EveningSelfStudyClock.Views.FullScreenClockWindow"
        Title="{Binding WindowTitle}"
        WindowState="FullScreen"
        SystemDecorations="None"
        ShowInTaskbar="False"
        CanResize="False"
        Background="#000000"
        FontFamily="Microsoft YaHei,SimHei,sans-serif">

    <Grid RowDefinitions="Auto,*,Auto,Auto"
          Margin="40,30,40,18">

        <!-- 日期 -->
        <TextBlock Grid.Row="0" Text="{Binding CurrentDate}"
                   FontSize="22" Foreground="#66ffffff"
                   HorizontalAlignment="Right"/>

        <!-- 主体 -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">
            <!-- 时间 -->
            <TextBlock Text="{Binding CurrentTime}"
                       FontSize="{Binding ClockFontSize}"
                       FontWeight="Bold"
                       Foreground="#ffffff"
                       FontFamily="Consolas,monospace"
                       HorizontalAlignment="Center"/>

            <!-- 课程时间信息 -->
            <TextBlock Text="{Binding CourseInfoText}"
                       FontSize="28" FontWeight="Bold"
                       Foreground="#88ccff"
                       HorizontalAlignment="Center"
                       IsVisible="{Binding ShowCourseInfo}"/>

            <!-- 分贝 -->
            <Border Background="#1a1a2e" CornerRadius="16" Padding="32,20" Width="640"
                    HorizontalAlignment="Center"
                    IsVisible="{Binding ShowDecibelMeter}">
                <StackPanel Spacing="12">
                    <TextBlock Text="📢 教室音量" FontSize="18" Foreground="#aaffffff" HorizontalAlignment="Center"/>
                    <ProgressBar Value="{Binding NoiseLevelProgress}"
                                 Minimum="0" Maximum="100" Height="10"
                                 Background="#33ffffff"
                                 Foreground="{Binding AccentColor}"
                                 CornerRadius="5"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                        <TextBlock Text="{Binding NoiseLevelEmoji}" FontSize="36"/>
                        <TextBlock Text="{Binding NoiseLevelText}" FontSize="32" FontWeight="Bold"
                                   Foreground="#ffffff" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 底部 -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,6,0,0">
            <!-- 吵闹计数（分段着色：一般=黄，吵闹=红） -->
            <ItemsControl Grid.Column="0" ItemsSource="{Binding NoisyDisplaySegments}"
                          VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}"
                                   FontSize="24" FontWeight="Bold"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Grid.Column="1" Content="✕ 退出全屏时钟"
                    FontSize="15" Foreground="#ffffff44"
                    Background="#22ffffff" BorderThickness="0"
                    CornerRadius="6" Padding="12,6"
                    Cursor="Hand" Opacity="0.5"
                    Click="ExitButton_Click">
                <Button.Styles>
                    <Style Selector="Button:pointerover">
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="Background" Value="#44ffffff"/>
                    </Style>
                </Button.Styles>
            </Button>
        </Grid>

        <!-- 记录规则 + 免责声明 -->
        <TextBlock Grid.Row="3" Text="{Binding RulesText}"
                   FontSize="12" Foreground="#55ffffff"
                   HorizontalAlignment="Center" TextAlignment="Center"
                   TextWrapping="Wrap" Margin="0,10,0,0"/>
    </Grid>
</Window>
